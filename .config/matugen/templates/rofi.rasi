/* Gerado pelo matugen (apply-theme.sh) — paleta do wallpaper atual. Não edite à mão. */
* {
    rice-bg:            {{ colors.surface_container_low.default.hex }}f0;
    rice-bg-solid:      {{ colors.surface_container_low.default.hex }};
    rice-surface:       {{ colors.surface_container.default.hex }};
    rice-surface-high:  {{ colors.surface_container_high.default.hex }};
    rice-surface-top:   {{ colors.surface_container_highest.default.hex }};
    rice-fg:            {{ colors.on_surface.default.hex }};
    rice-fg-dim:        {{ colors.on_surface_variant.default.hex }};
    rice-outline:       {{ colors.outline.default.hex }};
    rice-outline-dim:   {{ colors.outline_variant.default.hex }};
    rice-primary:       {{ colors.primary.default.hex }};
    rice-on-primary:    {{ colors.on_primary.default.hex }};
    rice-primary-cont:  {{ colors.primary_container.default.hex }};
    rice-on-primary-cont: {{ colors.on_primary_container.default.hex }};
    rice-secondary-cont: {{ colors.secondary_container.default.hex }};
    rice-on-secondary-cont: {{ colors.on_secondary_container.default.hex }};
    rice-tertiary:      {{ colors.tertiary.default.hex }};
    rice-error:         {{ colors.error.default.hex }};
}
