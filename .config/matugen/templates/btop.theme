# Gerado pelo matugen (apply-theme.sh) — tema do btop com as cores do wallpaper.
# Ativo só no Hyprland (wrapper ~/.config/scripts/bin/btop). Não edite à mão.
theme[main_bg]="{{ colors.surface.default.hex }}"
theme[main_fg]="{{ colors.on_surface.default.hex }}"
theme[title]="{{ colors.on_surface.default.hex }}"
theme[hi_fg]="{{ colors.primary.default.hex }}"
theme[selected_bg]="{{ colors.primary_container.default.hex }}"
theme[selected_fg]="{{ colors.on_primary_container.default.hex }}"
theme[inactive_fg]="{{ colors.outline.default.hex }}"
theme[graph_text]="{{ colors.on_surface_variant.default.hex }}"
theme[meter_bg]="{{ colors.surface_container_highest.default.hex }}"
theme[proc_misc]="{{ colors.tertiary.default.hex }}"
theme[cpu_box]="{{ colors.primary.default.hex }}"
theme[mem_box]="{{ colors.secondary.default.hex }}"
theme[net_box]="{{ colors.tertiary.default.hex }}"
theme[proc_box]="{{ colors.outline.default.hex }}"
theme[div_line]="{{ colors.outline_variant.default.hex }}"
theme[temp_start]="{{ colors.blue_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[temp_mid]="{{ colors.yellow_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[temp_end]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[cpu_start]="{{ colors.primary.default.hex }}"
theme[cpu_mid]="{{ colors.tertiary.default.hex }}"
theme[cpu_end]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[free_start]="{{ colors.green_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: -25.0 }}"
theme[free_mid]="{{ colors.green_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[free_end]="{{ colors.green_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: 10.0 }}"
theme[cached_start]="{{ colors.blue_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: -25.0 }}"
theme[cached_mid]="{{ colors.blue_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[cached_end]="{{ colors.blue_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: 10.0 }}"
theme[available_start]="{{ colors.yellow_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: -25.0 }}"
theme[available_mid]="{{ colors.yellow_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[available_end]="{{ colors.yellow_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: 10.0 }}"
theme[used_start]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: -25.0 }}"
theme[used_mid]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
theme[used_end]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} | lighten: 10.0 }}"
theme[download_start]="{{ colors.primary_container.default.hex }}"
theme[download_mid]="{{ colors.primary.default.hex }}"
theme[download_end]="{{ colors.primary.default.hex | lighten: 10.0 }}"
theme[upload_start]="{{ colors.tertiary_container.default.hex }}"
theme[upload_mid]="{{ colors.tertiary.default.hex }}"
theme[upload_end]="{{ colors.tertiary.default.hex | lighten: 10.0 }}"
theme[process_start]="{{ colors.primary.default.hex }}"
theme[process_mid]="{{ colors.tertiary.default.hex }}"
theme[process_end]="{{ colors.red_source.default.hex | harmonize: {{ colors.source_color.default.hex }} }}"
